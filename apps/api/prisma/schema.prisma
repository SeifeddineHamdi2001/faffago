// Faffa Go — database schema
//
// Conventions
//   Money      integer millimes in BIGINT, named *Millimes. Never a float.
//   Rates      integers in basis points (300 = 3 %), so a percentage stays exact.
//   GPS        Decimal(9,6). Never used for money.
//   Snapshots  any value that must not move when a setting changes is copied
//              onto the row when it is created (fees on a parcel, the retenue
//              rate on a bon, the courier rate on a delivered parcel).
//   Actors     structural links are real relations; pure "who did this" columns
//              are plain indexed UUIDs whose foreign keys are declared in SQL,
//              so that User does not carry twenty-five back-relations (D-3).
//
// Enum members are mirrored one-for-one in packages/shared. Adding, renaming or
// reusing a status requires an explicit decision (CLAUDE.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  DEPOT
  SERVICE_CLIENT
  VENDEUR
  LIVREUR
  RAMASSEUR
}

/// Where a session lives; decides its lifetime (Q11).
enum AuthClient {
  WEB
  COURIER_APP
}

enum Langue {
  FR
  AR
}

/// Fiscal status of a seller. Drives the 3 % retenue à la source.
enum SellerStatut {
  PATENTE
  AUTO_ENTREPRENEUR
  CIN_UNIQUEMENT
}

/// Fixed list (D-33). Labels in packages/shared (PRODUCT_CATEGORY_LABELS_FR).
enum ProductCategory {
  MODE_VETEMENTS
  CHAUSSURES
  BIJOUX_ACCESSOIRES
  BEAUTE_COSMETIQUE
  ELECTRONIQUE
  MAISON_DECO
  ENFANTS_BEBES
  SPORT
  ALIMENTATION
  AUTRE
}

enum SellerAccountState {
  ACTIF
  SUSPENDU
}

enum CourierAccountState {
  ACTIF
  INACTIF
}

enum PayPlan {
  JOURNALIER
  HEBDOMADAIRE
  MENSUEL
}

enum ZoneAssignmentKind {
  TITULAIRE
  BACKUP
}

enum ParcelStatus {
  CREE
  RAMASSE
  AU_DEPOT
  EN_LIVRAISON
  LIVRE
  A_VERIFIER
  RELANCE
  RETOUR_AU_DEPOT
  RETOUR_EN_ROUTE
  RETOUR_RECU
  ANNULE
}

/// Physical whereabouts, tracked apart from the status (D-1).
enum ParcelLocation {
  CHEZ_LE_VENDEUR
  AVEC_LE_RAMASSEUR
  AU_DEPOT
  AVEC_LE_LIVREUR
  CHEZ_LE_CLIENT
  RENDU_AU_VENDEUR
}

enum ParcelCashStatus {
  CHEZ_LE_COURSIER
  AU_DEPOT
  PAYE
}

/// Why a parcel is in RELANCE (D-9). The seller's own Relancer and a
/// customer postponement reach the same status but are shown differently.
enum RelaunchOrigin {
  VENDEUR
  CLIENT
}

enum RelaunchSlot {
  MATIN
  APRES_MIDI
  SOIR
}

enum FailureReason {
  NE_REPOND_PAS
  INJOIGNABLE
  ADRESSE_INCORRECTE
  REPORTE_PAR_LE_CLIENT
  REFUSE
}

enum ParcelEventType {
  CREATION
  MODIFICATION_VENDEUR
  ANNULATION
  RAMASSAGE
  ENTREE_DEPOT
  SORTIE_COURSIER
  AFFECTATION_LIVREUR
  LIVRAISON
  ECHEC_LIVRAISON
  RETOUR_DE_TOURNEE
  DECISION_RELANCER
  DECISION_RETOURNER
  DECISION_CHANGER_CLIENT
  RETOUR_AUTO_48H
  RETOUR_AUTO_3E_TENTATIVE
  PREPARATION_RETOUR
  DEPART_RETOUR
  RETOUR_RECU
  ENCAISSEMENT_DEPOT
  PAIEMENT_VENDEUR
  ARTICLE_ECHANGE_RECUPERE
  FORCAGE_STATUT
  ANNULATION_SCAN
  MODIFICATION_APPLIQUEE
  /// A return taken out and not handed over, back at the depot (D-81).
  RETOUR_NON_REMIS
}

enum ScanAction {
  RAMASSAGE
  ENTREE_DEPOT
  SORTIE_COURSIER
  LIVRE
  ECHEC
  RETOUR_DE_TOURNEE
  PREPARATION_RETOURS
  RETOUR_RECU
  BON_VERSEMENT_REMIS
  ARCHIVAGE_BON
}

enum ScanSource {
  APP_COURSIER
  WEB_CAMERA
  WEB_DOUCHETTE
  SAISIE_MANUELLE
}

/// The time window of a pickup request (D-35).
enum PickupSlot {
  MATIN
  APRES_MIDI
}

enum PickupStatus {
  DEMANDE
  PLANIFIE
  EFFECTUE
  ANNULE
}

/// Shared by bons de versement and bons de retour.
/// ANNULE is not in the specs' flow; it exists for the admin-only cancellation
/// of a bon that never reached the seller (A-5b).
enum BonStatus {
  PREPARE
  EN_ROUTE
  REMIS
  ARCHIVE
  ANNULE
}

enum ChargeType {
  LIVRAISON
  RETOUR
  CHANGEMENT_CLIENT
  RAMASSAGE
}

enum ChargeStatus {
  EN_ATTENTE
  DEDUITE
  ANNULEE
}

enum CaisseSessionStatus {
  OUVERTE
  COMPTEE
  CLOTUREE
}

/// A delivery of the session's day, or one synced after its own day was
/// closed (D-79).
enum CaisseLineOrigin {
  JOUR
  TARDIF
}

enum DebtStatus {
  EN_COURS
  DEDUITE
  ANNULEE
}

enum PayslipStatus {
  A_PAYER
  PAYEE
}

enum SellerDocumentType {
  CIN_RECTO
  CIN_VERSO
  PATENTE
  CARTE_AUTO_ENTREPRENEUR
}

/// RETIREE: withdrawn by the seller while it was waiting (D-44).
enum ChangeRequestStatus {
  EN_ATTENTE
  APPLIQUEE
  REFUSEE
  RETIREE
}

enum ChatParticipantKind {
  VENDEUR
  COURSIER
  FAFFA_GO
}

/// The life of a parcel chat (Q15). VERROUILLE means the seller and the
/// couriers can only read while no livreur holds the parcel; Faffa Go staff
/// still reply, which is how À vérifier and returns are followed up.
enum ChatThreadState {
  OUVERT
  VERROUILLE
  CLOS
}

enum BonRetourItemType {
  COLIS
  ARTICLE_RECUPERE
}

enum NotificationType {
  COLIS_A_VERIFIER
  COLIS_24H_RESTANTES
  COLIS_RETOUR_AUTO_48H
  COLIS_EN_RETOUR
  BON_VERSEMENT_EN_ROUTE
  BON_RETOUR_EN_ROUTE
  RAMASSAGE_PLANIFIE
  RAMASSAGE_EFFECTUE
  NOUVEAU_MESSAGE
  COMPTE_SUSPENDU
  COMPTE_REACTIVE
  NOUVELLE_DEMANDE_RAMASSAGE
  DEMANDE_MODIFICATION
  ECART_CAISSE
  BON_NON_REMIS
  COURSIER_A_PAYER
  NOUVEAUX_COLIS_ASSIGNES
  COLIS_RELANCE_AUJOURDHUI
  COLIS_REPORTE_PAR_CLIENT
  RAPPEL_FIN_DE_JOURNEE
}

enum DocumentCounterKind {
  BON_VERSEMENT
  BON_RETOUR
  FICHE_PAIE
  CERTIFICAT_RETENUE
}

// ─────────────────────────────────────────────────────────────
// IDENTITY
// ─────────────────────────────────────────────────────────────

/// Login identifiers differ by role (A-20): sellers use their email, staff a
/// username, couriers their phone plus the role they pick on the login screen.
/// A CHECK constraint in the first migration enforces "the right one is set".
model User {
  id       String  @id @default(uuid()) @db.Uuid
  role     Role
  /// Sellers only.
  email    String? @unique
  /// Admin, Dépôt and Service client only.
  username String? @unique
  /// Couriers log in with it; sellers keep it so the courier can call them.
  phone    String  @db.VarChar(8)

  /// argon2id. Generated by the admin, shown once, never readable again.
  passwordHash      String
  passwordUpdatedAt DateTime @default(now())

  firstName   String
  lastName    String
  isActive    Boolean @default(true)
  /// False on a former account after a role change: the person can still log
  /// in and see what is owed, but receives no new work (Admin 4.15).
  acceptsWork Boolean @default(true)
  langue      Langue  @default(FR)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  seller        Seller?
  courier       Courier?
  refreshTokens RefreshToken[]
  notifications Notification[]
  chatMessages  ChatMessage[]
  chatReads     ChatRead[]
  scans         Scan[]

  /// One LIVREUR and one RAMASSEUR account may share a phone (Admin 4.15).
  @@unique([phone, role])
  @@index([role, isActive])
  @@map("users")
}

/// One row per logged-in device: the session. Its id is the `sid` carried by
/// every access token, so revoking the row signs the device out at its next
/// request, not when the access token happens to expire.
model RefreshToken {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String     @db.Uuid
  client            AuthClient
  /// HMAC of the current refresh token. Rotated on every refresh.
  tokenHash         String     @unique
  /// The token it replaced. Presented again, it means the token was copied,
  /// and the whole session is revoked.
  previousTokenHash String?    @unique
  deviceId          String?
  ip                String?
  userAgent         String?
  /// Sliding: pushed forward on every refresh (Q11).
  expiresAt         DateTime
  /// Drives the 30-minute staff idle logout (Q11).
  lastUsedAt        DateTime   @default(now())
  revokedAt         DateTime?
  revokedReason     String?
  createdAt         DateTime   @default(now())

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonationSessions ImpersonationSession[]

  @@index([userId])
  @@map("refresh_tokens")
}

/// "Voir comme le vendeur" (D-5): read-only, 30 minutes, no refresh. A row per
/// use, so the end can be audited even when the admin never presses exit.
model ImpersonationSession {
  id             String    @id @default(uuid()) @db.Uuid
  adminUserId    String    @db.Uuid
  /// The admin's own session. Revoking it ends the impersonation too.
  adminSessionId String    @db.Uuid
  sellerId       String    @db.Uuid
  startedAt      DateTime  @default(now())
  expiresAt      DateTime
  endedAt        DateTime?
  /// SORTIE (exit button), EXPIRATION, or SESSION_REVOQUEE.
  endReason      String?

  adminSession RefreshToken @relation(fields: [adminSessionId], references: [id], onDelete: Cascade)
  seller       Seller       @relation(fields: [sellerId], references: [id])

  @@index([adminUserId, startedAt])
  @@index([endedAt, expiresAt])
  @@map("impersonation_sessions")
}

// ─────────────────────────────────────────────────────────────
// SELLERS
// ─────────────────────────────────────────────────────────────

model Seller {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @unique @db.Uuid
  shopName        String
  productCategory ProductCategory
  storeLink       String?
  /// The CIN holder. The only person a courier hands cash or returns to.
  contactFullName String
  contactPhone    String             @db.VarChar(8)
  statut          SellerStatut
  accountState    SellerAccountState @default(ACTIF)
  createdByUserId String             @db.Uuid
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user            User                   @relation(fields: [userId], references: [id])
  documents       SellerDocument[]
  pickupAddresses PickupAddress[]
  parcels         Parcel[]
  pickups         Pickup[]
  charges         SellerCharge[]
  bonsVersement   BonVersement[]
  bonsRetour      BonRetour[]
  changeRequests  SellerChangeRequest[]
  certificates    RetenueCertificate[]
  impersonations  ImpersonationSession[]
  imports         ParcelImport[]

  @@index([accountState])
  @@map("sellers")
}

/// Private storage only, admin-only access, never a public URL (CLAUDE.md).
/// The file is encrypted with AES-256-GCM before it reaches the disk (D-32).
/// Never deleted: a replaced document keeps its row and its file, and a
/// trigger allows no change but marking it replaced, once.
model SellerDocument {
  id               String             @id @default(uuid()) @db.Uuid
  sellerId         String             @db.Uuid
  type             SellerDocumentType
  storageKey       String             @unique
  /// After re-encoding: the type the admin downloads.
  mimeType         String
  /// Of the document, before encryption.
  sizeBytes        Int
  /// Of the encrypted file on disk, so a restore can be checked without the key.
  sha256           String             @db.Char(64)
  /// Which key encrypted it, so the key can be rotated (D-32).
  encryptionKeyId  String
  encryptionIv     Bytes
  encryptionTag    Bytes
  uploadedByUserId String             @db.Uuid
  uploadedAt       DateTime           @default(now())
  replacedAt       DateTime?
  replacedById     String?            @unique @db.Uuid

  seller     Seller          @relation(fields: [sellerId], references: [id])
  replacedBy SellerDocument? @relation("SellerDocumentReplacement", fields: [replacedById], references: [id])
  replaces   SellerDocument? @relation("SellerDocumentReplacement")

  @@index([sellerId])
  @@map("seller_documents")
}

model PickupAddress {
  id           String   @id @default(uuid()) @db.Uuid
  sellerId     String   @db.Uuid
  label        String?
  delegationId String   @db.Uuid
  /// The délégation always comes from the localité (D-17); the two-column key
  /// below makes a disagreement impossible.
  localiteId   String   @db.Uuid
  address      String
  landmark     String?
  /// One default per seller, and only an active one.
  isDefault    Boolean  @default(false)
  /// False once replaced or no longer used: kept for the pickups that used it (D-35).
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  replacedById String?  @unique @db.Uuid

  seller     Seller         @relation(fields: [sellerId], references: [id])
  delegation Delegation     @relation(fields: [delegationId], references: [id])
  localite   Localite       @relation(fields: [localiteId, delegationId], references: [id, delegationId], onDelete: Restrict, onUpdate: Restrict)
  pickups    Pickup[]
  replacedBy PickupAddress? @relation("PickupAddressReplacement", fields: [replacedById], references: [id])
  replaces   PickupAddress? @relation("PickupAddressReplacement")

  @@index([sellerId])
  @@map("pickup_addresses")
}

// ─────────────────────────────────────────────────────────────
// COURIERS
// ─────────────────────────────────────────────────────────────

model Courier {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @unique @db.Uuid
  cin                String
  vehicle            String?
  /// Livreurs only. Ramasseurs are employees paid by HR outside the app.
  payPlan            PayPlan?
  /// The day the plan in force took effect; a change waits for the next
  /// period (A-16, D-82). CHECK couriers_pending_plan_complete.
  payPlanSince       DateTime            @default(now()) @db.Date
  pendingPayPlan     PayPlan?
  pendingPayPlanFrom DateTime?           @db.Date
  accountState       CourierAccountState @default(ACTIF)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  zoneAssignments ZoneAssignment[]
  absences        CourierAbsence[]
  caisseSessions  CaisseSession[]
  debts           CourierDebt[]
  payslips        Payslip[]
  plannedParcels  Parcel[]         @relation("ParcelPlannedLivreur")
  deliveryParcels Parcel[]         @relation("ParcelLivreur")
  pickups         Pickup[]
  bonsVersement   BonVersement[]
  bonsRetour      BonRetour[]
  chatThreads     ChatThread[]
  targetedScans   Scan[]           @relation("ScanTargetCourier")

  @@index([accountState])
  @@map("couriers")
}

model CourierAbsence {
  id              String   @id @default(uuid()) @db.Uuid
  courierId       String   @db.Uuid
  date            DateTime @db.Date
  reason          String?
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now())

  courier Courier @relation(fields: [courierId], references: [id])

  @@unique([courierId, date])
  @@map("courier_absences")
}

// ─────────────────────────────────────────────────────────────
// GEOGRAPHY AND ZONES
// ─────────────────────────────────────────────────────────────

/// Both names are required: the public site lists the zones served in French
/// and in Arabic, and each interface shows the one for its language (A-18).
model Gouvernorat {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  nameFr   String
  nameAr   String
  isActive Boolean @default(true)

  delegations Delegation[]

  @@map("gouvernorats")
}

model Delegation {
  id            String  @id @default(uuid()) @db.Uuid
  gouvernoratId String  @db.Uuid
  /// Stable identifier a seller can put in a CSV instead of a name.
  code          String  @unique
  nameFr        String
  nameAr        String
  zoneId        String? @db.Uuid
  isActive      Boolean @default(true)

  gouvernorat     Gouvernorat     @relation(fields: [gouvernoratId], references: [id])
  zone            Zone?           @relation(fields: [zoneId], references: [id])
  localites       Localite[]
  parcels         Parcel[]
  pickupAddresses PickupAddress[]

  /// Délégation names repeat across gouvernorats, so a CSV that gives a name
  /// must give its gouvernorat too; this pair is what the importer looks up.
  @@unique([gouvernoratId, nameFr])
  @@index([zoneId])
  @@map("delegations")
}

/// The third level under the délégation (D-17). Zones stay at délégation
/// level: a localité inherits its délégation's zone. Whether a name is
/// ambiguous is computed from the list, never stored.
model Localite {
  id           String   @id @default(uuid()) @db.Uuid
  delegationId String   @db.Uuid
  nameFr       String
  /// Optional: when empty, every screen shows the French name.
  nameAr       String?
  /// The first postal code; any others are in the aliases.
  postalCode   String?  @db.VarChar(4)
  aliases      String[] @default([])
  /// The "Autre" row: one per délégation, never renamed or deactivated.
  isOther      Boolean  @default(false)
  isActive     Boolean  @default(true)
  /// "ARI-VILLE|Cité Ennasr 1", written by the seed only, so a localité the
  /// admin has renamed is never created again by a later seed run.
  sourceKey    String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  delegation      Delegation      @relation(fields: [delegationId], references: [id])
  parcels         Parcel[]
  pickupAddresses PickupAddress[]

  @@unique([delegationId, nameFr])
  /// Target of the two-column keys of parcels and pickup addresses.
  @@unique([id, delegationId])
  @@map("localites")
}

model Zone {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  isActive Boolean @default(true)

  delegations Delegation[]
  assignments ZoneAssignment[]

  @@map("zones")
}

/// Each zone has a livreur and a ramasseur, each with a backup (Admin 4.5).
model ZoneAssignment {
  id        String             @id @default(uuid()) @db.Uuid
  zoneId    String             @db.Uuid
  courierId String             @db.Uuid
  role      Role
  kind      ZoneAssignmentKind

  zone    Zone    @relation(fields: [zoneId], references: [id])
  courier Courier @relation(fields: [courierId], references: [id])

  @@unique([zoneId, role, kind])
  @@index([courierId])
  @@map("zone_assignments")
}

// ─────────────────────────────────────────────────────────────
// SETTINGS
// ─────────────────────────────────────────────────────────────

/// One row per setting; every change is written to audit_log.
model Setting {
  key             String   @id
  value           Json
  updatedByUserId String?  @db.Uuid
  updatedAt       DateTime @updatedAt

  @@map("settings")
}

/// Per kind and per day sequence behind BV-2026-0921-01 and BR-2026-0921-01.
/// Locked inside the transaction that creates the document, so two admins
/// preparing bons at the same second cannot collide.
model DocumentCounter {
  kind      DocumentCounterKind
  dateKey   String
  lastValue Int                 @default(0)

  @@id([kind, dateKey])
  @@map("document_counters")
}

// ─────────────────────────────────────────────────────────────
// PARCELS
// ─────────────────────────────────────────────────────────────

model Parcel {
  id       String @id @default(uuid()) @db.Uuid
  /// FG- plus 8 Crockford characters, random, never sequential (A-19).
  code     String @unique
  sellerId String @db.Uuid

  recipientName   String
  recipientPhone  String  @db.VarChar(8)
  recipientPhone2 String? @db.VarChar(8)
  delegationId    String  @db.Uuid
  /// The délégation always comes from the localité (D-17).
  localiteId      String  @db.Uuid
  address         String
  /// Shown large on the courier screen, so it is its own field (A-21).
  landmark        String?

  productDescription String
  pieceCount         Int     @default(1)
  isExchange         Boolean @default(false)
  openingAllowed     Boolean @default(false)
  courierNote        String?

  codAmountMillimes BigInt

  /// Rates frozen at creation. A settings change never touches an existing
  /// parcel (CLAUDE.md, Money). The charge rows are created later, when the
  /// event that owes them happens, using these amounts.
  deliveryFeeMillimes     BigInt
  returnFeeMillimes       BigInt
  changeClientFeeMillimes BigInt
  /// Frozen at delivery, not at creation: it is the livreur's pay, and only a
  /// delivered parcel earns it (A-15).
  courierRateMillimes     BigInt?

  status     ParcelStatus      @default(CREE)
  location   ParcelLocation    @default(CHEZ_LE_VENDEUR)
  cashStatus ParcelCashStatus?

  attemptCount      Int             @default(0)
  lastFailureReason FailureReason?
  lastFailureNote   String?
  /// Set on entering À vérifier, cleared by any decision. The scheduled job
  /// reads it; it stops at the decision, not at the return scan (A-7).
  verifyDeadlineAt  DateTime?
  /// The day the parcel goes out again, and who asked for it (D-9).
  relaunchDate      DateTime?       @db.Date
  relaunchSlot      RelaunchSlot?
  relaunchOrigin    RelaunchOrigin?
  changeClientCount Int             @default(0)
  /// Recorded when the customer prefers to meet somewhere (Coursier 4.3).
  meetingPoint      String?

  /// The Tournées screen fills the zone's column; the Sortie coursier scan is
  /// what actually assigns the parcel (Admin 4.5).
  plannedLivreurId String? @db.Uuid
  currentLivreurId String? @db.Uuid

  /// A printed field changed after the label was printed: the depot reprints
  /// it with the same code (A-9, D-57). Cleared by the team's reprint.
  labelReprintNeeded Boolean @default(false)

  /// Old item of an échange: same code, no new label, its own line in Retours
  /// and no return fee (A-10).
  exchangeItemCollected Boolean       @default(false)
  exchangeItemStatus    ParcelStatus?

  createdByUserId String    @db.Uuid
  /// Drawn by the seller's form when it opens: a retried creation finds the
  /// parcel instead of making a second one.
  clientRequestId String?   @unique @db.Uuid
  /// Import CSV: the file and the line the parcel came from (Vendeur 4.3).
  importId        String?   @db.Uuid
  importLine      Int?
  createdAt       DateTime  @default(now())
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  closedAt        DateTime?
  updatedAt       DateTime  @updatedAt

  seller            Seller                @relation(fields: [sellerId], references: [id])
  import            ParcelImport?         @relation(fields: [importId], references: [id])
  delegation        Delegation            @relation(fields: [delegationId], references: [id])
  localite          Localite              @relation(fields: [localiteId, delegationId], references: [id, delegationId], onDelete: Restrict, onUpdate: Restrict)
  plannedLivreur    Courier?              @relation("ParcelPlannedLivreur", fields: [plannedLivreurId], references: [id])
  currentLivreur    Courier?              @relation("ParcelLivreur", fields: [currentLivreurId], references: [id])
  events            ParcelEvent[]
  scans             Scan[]
  charges           SellerCharge[]
  pickupLinks       PickupParcel[]
  bonVersementLines BonVersementParcel[]
  bonRetourLines    BonRetourParcel[]
  caisseLine        CaisseSessionParcel?
  payslipLine       PayslipParcel[]
  chatThread        ChatThread?
  calls             FaffaGoCall[]
  changeRequests    SellerChangeRequest[]
  clientChanges     ParcelClientChange[]

  @@unique([importId, importLine])
  @@index([sellerId, status])
  @@index([status, location])
  @@index([currentLivreurId, status])
  @@index([delegationId, status])
  @@index([localiteId])
  @@index([cashStatus, sellerId])
  @@index([verifyDeadlineAt])
  @@index([recipientPhone])
  @@index([createdAt])
  @@map("parcels")
}

/// Import CSV (Vendeur 4.3, D-37): one file, its parcels created together.
/// The id is drawn by the seller's screen, so a retried import creates nothing twice.
model ParcelImport {
  id              String   @id @db.Uuid
  sellerId        String   @db.Uuid
  createdByUserId String   @db.Uuid
  fileName        String
  parcelCount     Int
  createdAt       DateTime @default(now())

  seller  Seller   @relation(fields: [sellerId], references: [id])
  parcels Parcel[]

  @@index([sellerId, createdAt])
  @@map("parcel_imports")
}

/// Changer de client overwrites the customer on the parcel, so the previous
/// one is kept here. Staff-visible history; the seller and the public tracking
/// page see only the new customer and a "Changement de client" event (A-17).
model ParcelClientChange {
  id                     String   @id @default(uuid()) @db.Uuid
  parcelId               String   @db.Uuid
  previousName           String
  previousPhone          String   @db.VarChar(8)
  previousDelegationId   String   @db.Uuid
  /// Keyed with previousDelegationId in the migration, like the parcel (D-17).
  previousLocaliteId     String   @db.Uuid
  previousAddress        String
  /// The rest of the old customer and his options, kept whole (A-17, D-74).
  previousPhone2         String?  @db.VarChar(8)
  previousLandmark       String?
  previousCourierNote    String?
  previousIsExchange     Boolean  @default(false)
  previousOpeningAllowed Boolean  @default(false)
  previousCodMillimes    BigInt
  newCodMillimes         BigInt
  feeMillimes            BigInt
  chargeId               String?  @db.Uuid
  decidedByUserId        String   @db.Uuid
  createdAt              DateTime @default(now())

  parcel Parcel @relation(fields: [parcelId], references: [id])

  @@index([parcelId])
  @@map("parcel_client_changes")
}

/// APPEND-ONLY. UPDATE and DELETE are revoked for the application role and
/// blocked by a trigger (see the first migration).
model ParcelEvent {
  id               String          @id @default(uuid()) @db.Uuid
  parcelId         String          @db.Uuid
  type             ParcelEventType
  previousStatus   ParcelStatus?
  newStatus        ParcelStatus?
  previousLocation ParcelLocation?
  newLocation      ParcelLocation?
  /// Null for a scheduled job: the 48-hour return has no human actor.
  actorUserId      String?         @db.Uuid
  actorRole        Role?
  source           ScanSource?
  scanId           String?         @db.Uuid
  reasonCode       FailureReason?
  reasonText       String?
  gpsLat           Decimal?        @db.Decimal(9, 6)
  gpsLng           Decimal?        @db.Decimal(9, 6)
  gpsAccuracyM     Int?
  deviceId         String?
  appVersion       String?
  deviceTime       DateTime?
  serverTime       DateTime        @default(now())
  /// The order events were written in, even within one transaction.
  sequence         BigInt          @unique @default(autoincrement())
  metadata         Json?
  /// The transaction that wrote the event. A deferred trigger refuses, at
  /// commit, a parcel created or moved without an event of its own
  /// transaction ending in that state (D-21). Never set by the application.
  txid             BigInt          @default(dbgenerated("txid_current()"))

  parcel Parcel @relation(fields: [parcelId], references: [id])

  @@index([parcelId, serverTime])
  @@index([type, serverTime])
  @@map("parcel_events")
}

// ─────────────────────────────────────────────────────────────
// SCANS
// ─────────────────────────────────────────────────────────────

/// There is deliberately no unique index on (parcelId, action): a parcel is
/// legitimately scanned ECHEC up to three times. "The same parcel cannot be
/// scanned twice for the same action" is enforced by the state machine and by
/// the phone's local queue; clientScanId alone gives idempotency.
model Scan {
  id                String         @id @default(uuid()) @db.Uuid
  /// UUID generated on the device. Replaying it returns the first result.
  clientScanId      String         @unique @db.Uuid
  action            ScanAction
  rawCode           String
  parcelId          String?        @db.Uuid
  bonVersementId    String?        @db.Uuid
  bonRetourId       String?        @db.Uuid
  pickupId          String?        @db.Uuid
  actorUserId       String         @db.Uuid
  source            ScanSource
  /// The courier chosen on the station before scanning (D-53): the livreur a
  /// Sortie coursier assigns, the one a Retour de tournée takes back from.
  targetCourierId   String?        @db.Uuid
  /// Allowed when a label is damaged, but flagged to the admin (Coursier 01).
  manualEntry       Boolean        @default(false)
  accepted          Boolean
  refusalReason     String?
  failureReason     FailureReason?
  collectedMillimes BigInt?
  /// What the parcel was just before an accepted depot scan, so the scan can
  /// be cancelled (D-53, D-54). See `ParcelBefore` in packages/shared.
  parcelBefore      Json?

  gpsLat       Decimal? @db.Decimal(9, 6)
  gpsLng       Decimal? @db.Decimal(9, 6)
  gpsAccuracyM Int?
  deviceId     String?
  appVersion   String?

  deviceTime       DateTime
  receivedAt       DateTime @default(now())
  /// Business day derived from the device time, used by the Caisse (A-12).
  businessDate     DateTime @db.Date
  /// Device clock more than the configured minutes away from the server (A-12).
  clockSkewFlagged Boolean  @default(false)
  clockSkewMs      Int?

  /// "Annuler le dernier scan" within one minute of the device time (A-11).
  /// The cancellation writes a compensating event; the scan row stays.
  cancelledAt       DateTime?
  cancelledByUserId String?   @db.Uuid
  cancelReason      String?

  /// "Marquer comme traité" on a Saisie manuelle exception (A-22): who and
  /// when, so the entry leaves the Exceptions queue.
  treatedAt       DateTime?
  treatedByUserId String?   @db.Uuid

  parcel        Parcel?  @relation(fields: [parcelId], references: [id])
  actor         User     @relation(fields: [actorUserId], references: [id])
  targetCourier Courier? @relation("ScanTargetCourier", fields: [targetCourierId], references: [id])

  @@index([parcelId, action])
  @@index([actorUserId, businessDate])
  @@index([manualEntry, receivedAt])
  @@index([clockSkewFlagged, receivedAt])
  @@map("scans")
}

// ─────────────────────────────────────────────────────────────
// PICKUPS
// ─────────────────────────────────────────────────────────────

model Pickup {
  id                String       @id @default(uuid()) @db.Uuid
  sellerId          String       @db.Uuid
  pickupAddressId   String       @db.Uuid
  status            PickupStatus @default(DEMANDE)
  /// The seller either lists the parcels or just says how many (Vendeur 4.5).
  declaredCount     Int?
  requestedSlot     PickupSlot?
  note              String?
  plannedDate       DateTime?    @db.Date
  plannedSlot       PickupSlot?
  /// Who planned it last, and when (D-58). A planned pickup always has its
  /// day, window and ramasseur (CHECK pickups_planned_is_complete).
  plannedByUserId   String?      @db.Uuid
  plannedAt         DateTime?
  /// Pre-filled with the ramasseur of the zone of this pickup address (A-14).
  ramasseurId       String?      @db.Uuid
  completedAt       DateTime?
  scannedCount      Int          @default(0)
  /// Set when the pickup is closed below the free threshold with at least one
  /// parcel scanned; zero parcels costs nothing (A-13).
  feeChargeId       String?      @db.Uuid
  cancelledAt       DateTime?
  cancelledByUserId String?      @db.Uuid
  cancelReason      String?
  /// Drawn by the seller's form: a request sent twice is created once.
  clientRequestId   String?      @unique @db.Uuid
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  seller        Seller         @relation(fields: [sellerId], references: [id])
  pickupAddress PickupAddress  @relation(fields: [pickupAddressId], references: [id])
  ramasseur     Courier?       @relation(fields: [ramasseurId], references: [id])
  parcels       PickupParcel[]
  bonsVersement BonVersement[]
  bonsRetour    BonRetour[]

  @@index([sellerId, status])
  @@index([ramasseurId, plannedDate])
  @@index([status, plannedDate])
  @@map("pickups")
}

model PickupParcel {
  pickupId  String    @db.Uuid
  parcelId  String    @db.Uuid
  /// Announced by the seller. The pickup screen shows expected versus scanned.
  expected  Boolean   @default(true)
  scannedAt DateTime?
  scanId    String?   @db.Uuid

  pickup Pickup @relation(fields: [pickupId], references: [id])
  parcel Parcel @relation(fields: [parcelId], references: [id])

  @@id([pickupId, parcelId])
  @@index([parcelId])
  @@map("pickup_parcels")
}

// ─────────────────────────────────────────────────────────────
// SELLER CHARGES — every deduction line of a bon de versement (D-2)
// ─────────────────────────────────────────────────────────────

model SellerCharge {
  id              String       @id @default(uuid()) @db.Uuid
  sellerId        String       @db.Uuid
  type            ChargeType
  /// Copied from the frozen rate on the parcel, or from the pickup fee setting.
  amountMillimes  BigInt
  status          ChargeStatus @default(EN_ATTENTE)
  parcelId        String?      @db.Uuid
  pickupId        String?      @db.Uuid
  bonVersementId  String?      @db.Uuid
  note            String?
  createdByUserId String?      @db.Uuid
  /// The scan whose event owed this charge; cancelling the scan within its
  /// minute marks it ANNULEE (A-1, A-11). Foreign key in the migration.
  scanId          String?      @db.Uuid
  createdAt       DateTime     @default(now())

  seller       Seller        @relation(fields: [sellerId], references: [id])
  parcel       Parcel?       @relation(fields: [parcelId], references: [id])
  bonVersement BonVersement? @relation(fields: [bonVersementId], references: [id])

  @@index([sellerId, status, createdAt])
  @@index([parcelId])
  @@index([bonVersementId])
  @@index([scanId])
  @@map("seller_charges")
}

// ─────────────────────────────────────────────────────────────
// BONS DE VERSEMENT
// ─────────────────────────────────────────────────────────────

model BonVersement {
  id       String    @id @default(uuid()) @db.Uuid
  number   String    @unique
  sellerId String    @db.Uuid
  status   BonStatus @default(PREPARE)

  totalCodMillimes      BigInt
  totalFeesMillimes     BigInt
  baseAfterFeesMillimes BigInt
  /// The seller's fiscal statut at preparation. A statut change stops or
  /// starts the retenue from the next bon, never retroactively (Vendeur 2.4).
  sellerStatutSnapshot  SellerStatut
  retenueRateBps        Int          @default(0)
  retenueMillimes       BigInt       @default(0)
  netMillimes           BigInt

  /// Printed on the bon; the ramasseur scans it to mark the bon Remis.
  qrToken           String    @unique
  preparedByUserId  String    @db.Uuid
  preparedAt        DateTime  @default(now())
  /// With no planned pickup, the ramasseur and the day the team assigned
  /// (D-80); while En route, the ramasseur carrying it.
  ramasseurId       String?   @db.Uuid
  plannedDate       DateTime? @db.Date
  pickupId          String?   @db.Uuid
  enRouteAt         DateTime?
  remisAt           DateTime?
  remisScanId       String?   @db.Uuid
  archivedAt        DateTime?
  archivedByUserId  String?   @db.Uuid
  /// Admin-only, with a reason, audited. The number is never reused (A-5b).
  cancelledAt       DateTime?
  cancelledByUserId String?   @db.Uuid
  cancelReason      String?
  pdfStorageKey     String?

  seller      Seller               @relation(fields: [sellerId], references: [id])
  ramasseur   Courier?             @relation(fields: [ramasseurId], references: [id])
  pickup      Pickup?              @relation(fields: [pickupId], references: [id])
  parcels     BonVersementParcel[]
  charges     SellerCharge[]
  certificate RetenueCertificate?
  caisseLines CaisseSessionBon[]

  @@index([sellerId, status])
  @@index([status, preparedAt])
  @@map("bons_versement")
}

model BonVersementParcel {
  bonVersementId String    @db.Uuid
  /// A parcel is on one active bon only (A-5a, Vendeur rule 05): the partial
  /// unique index bon_versement_parcels_active_parcel_key, in the migration,
  /// counts only lines not released by a cancelled bon (D-80).
  parcelId       String    @db.Uuid
  codMillimes    BigInt
  releasedAt     DateTime?

  bonVersement BonVersement @relation(fields: [bonVersementId], references: [id])
  parcel       Parcel       @relation(fields: [parcelId], references: [id])

  @@id([bonVersementId, parcelId])
  @@index([parcelId])
  @@map("bon_versement_parcels")
}

/// One certificate per bon that withheld something, plus a yearly summary the
/// seller downloads (Vendeur 4.11).
model RetenueCertificate {
  id             String   @id @default(uuid()) @db.Uuid
  number         String   @unique
  bonVersementId String   @unique @db.Uuid
  sellerId       String   @db.Uuid
  year           Int
  baseMillimes   BigInt
  rateBps        Int
  amountMillimes BigInt
  issuedAt       DateTime @default(now())
  pdfStorageKey  String?

  bonVersement BonVersement @relation(fields: [bonVersementId], references: [id])
  seller       Seller       @relation(fields: [sellerId], references: [id])

  @@index([sellerId, year])
  @@map("retenue_certificates")
}

// ─────────────────────────────────────────────────────────────
// BONS DE RETOUR
// ─────────────────────────────────────────────────────────────

model BonRetour {
  id                String    @id @default(uuid()) @db.Uuid
  number            String    @unique
  sellerId          String    @db.Uuid
  status            BonStatus @default(PREPARE)
  parcelCount       Int       @default(0)
  qrToken           String    @unique
  preparedByUserId  String    @db.Uuid
  preparedAt        DateTime  @default(now())
  ramasseurId       String?   @db.Uuid
  plannedDate       DateTime? @db.Date
  pickupId          String?   @db.Uuid
  enRouteAt         DateTime?
  remisAt           DateTime?
  archivedAt        DateTime?
  archivedByUserId  String?   @db.Uuid
  cancelledAt       DateTime?
  cancelledByUserId String?   @db.Uuid
  cancelReason      String?
  pdfStorageKey     String?

  seller    Seller            @relation(fields: [sellerId], references: [id])
  ramasseur Courier?          @relation(fields: [ramasseurId], references: [id])
  pickup    Pickup?           @relation(fields: [pickupId], references: [id])
  parcels   BonRetourParcel[]

  @@index([sellerId, status])
  @@map("bons_retour")
}

model BonRetourParcel {
  bonRetourId String            @db.Uuid
  parcelId    String            @db.Uuid
  /// A delivered échange parcel appears here as ARTICLE_RECUPERE while it also
  /// appears in a bon de versement as a paid parcel (A-10).
  itemType    BonRetourItemType @default(COLIS)
  receivedAt  DateTime?
  scanId      String?           @db.Uuid

  bonRetour BonRetour @relation(fields: [bonRetourId], references: [id])
  parcel    Parcel    @relation(fields: [parcelId], references: [id])

  @@id([bonRetourId, parcelId, itemType])
  @@index([parcelId])
  @@map("bon_retour_parcels")
}

// ─────────────────────────────────────────────────────────────
// CAISSE
// ─────────────────────────────────────────────────────────────

model CaisseSession {
  id           String              @id @default(uuid()) @db.Uuid
  courierId    String              @db.Uuid
  businessDate DateTime            @db.Date
  status       CaisseSessionStatus @default(OUVERTE)

  expectedDeliveryMillimes BigInt    @default(0)
  expectedBonCashMillimes  BigInt    @default(0)
  expectedTotalMillimes    BigInt    @default(0)
  countedMillimes          BigInt?
  /// compté − attendu. Negative becomes a courier debt, positive is flagged.
  ecartMillimes            BigInt?
  ecartFlagged             Boolean   @default(false)
  ecartNote                String?
  /// A positive écart checked by the admin, with the note (D-79, answer 3).
  ecartCheckedAt           DateTime?
  ecartCheckedByUserId     String?   @db.Uuid
  countedByUserId          String?   @db.Uuid

  openedAt       DateTime  @default(now())
  countedAt      DateTime?
  closedAt       DateTime?
  closedByUserId String?   @db.Uuid

  courier Courier               @relation(fields: [courierId], references: [id])
  parcels CaisseSessionParcel[]
  bons    CaisseSessionBon[]
  debts   CourierDebt[]

  @@unique([courierId, businessDate])
  @@index([businessDate, status])
  @@map("caisse_sessions")
}

model CaisseSessionParcel {
  caisseSessionId String           @db.Uuid
  parcelId        String           @unique @db.Uuid
  codMillimes     BigInt
  origin          CaisseLineOrigin @default(JOUR)

  caisseSession CaisseSession @relation(fields: [caisseSessionId], references: [id])
  parcel        Parcel        @relation(fields: [parcelId], references: [id])

  @@id([caisseSessionId, parcelId])
  @@map("caisse_session_parcels")
}

/// Bon cash a ramasseur left with in the morning, accounted for in the evening:
/// either handed to the seller or brought back in full (Admin 4.9).
model CaisseSessionBon {
  caisseSessionId  String @db.Uuid
  bonVersementId   String @db.Uuid
  takenOutMillimes BigInt
  remisMillimes    BigInt @default(0)
  returnedMillimes BigInt @default(0)

  caisseSession CaisseSession @relation(fields: [caisseSessionId], references: [id])
  bonVersement  BonVersement  @relation(fields: [bonVersementId], references: [id])

  @@id([caisseSessionId, bonVersementId])
  @@map("caisse_session_bons")
}

model CourierDebt {
  id                String     @id @default(uuid()) @db.Uuid
  courierId         String     @db.Uuid
  caisseSessionId   String?    @db.Uuid
  amountMillimes    BigInt
  /// What is still to deduct; a pay slip that cannot absorb it all leaves the
  /// rest for the next period (Admin 4.12).
  remainingMillimes BigInt
  status            DebtStatus @default(EN_COURS)
  /// Only the admin can cancel a debt, with a note (Admin rule 05).
  cancelledByUserId String?    @db.Uuid
  cancelReason      String?
  cancelledAt       DateTime?
  createdAt         DateTime   @default(now())

  courier       Courier            @relation(fields: [courierId], references: [id])
  caisseSession CaisseSession?     @relation(fields: [caisseSessionId], references: [id])
  deductions    PayslipDeduction[]

  @@index([courierId, status, createdAt])
  @@map("courier_debts")
}

// ─────────────────────────────────────────────────────────────
// PAIE COURSIERS (livreurs only)
// ─────────────────────────────────────────────────────────────

model Payslip {
  id                    String        @id @default(uuid()) @db.Uuid
  number                String        @unique
  courierId             String        @db.Uuid
  payPlan               PayPlan
  periodStart           DateTime      @db.Date
  periodEnd             DateTime      @db.Date
  parcelCount           Int
  /// Kept for the printed fiche; the authoritative amounts are the rates
  /// frozen on each parcel at delivery (A-15).
  ratePerParcelMillimes BigInt
  grossMillimes         BigInt
  deductionsMillimes    BigInt        @default(0)
  netMillimes           BigInt
  status                PayslipStatus @default(A_PAYER)
  paidAt                DateTime?
  paidByUserId          String?       @db.Uuid
  preparedByUserId      String        @db.Uuid
  preparedAt            DateTime      @default(now())
  pdfStorageKey         String?

  courier    Courier            @relation(fields: [courierId], references: [id])
  parcels    PayslipParcel[]
  deductions PayslipDeduction[]

  @@index([courierId, status])
  @@index([periodEnd, status])
  @@map("payslips")
}

model PayslipParcel {
  payslipId    String @db.Uuid
  /// A delivered parcel is paid to a courier once.
  parcelId     String @unique @db.Uuid
  rateMillimes BigInt

  payslip Payslip @relation(fields: [payslipId], references: [id])
  parcel  Parcel  @relation(fields: [parcelId], references: [id])

  @@id([payslipId, parcelId])
  @@map("payslip_parcels")
}

model PayslipDeduction {
  payslipId      String @db.Uuid
  debtId         String @db.Uuid
  amountMillimes BigInt

  payslip Payslip     @relation(fields: [payslipId], references: [id])
  debt    CourierDebt @relation(fields: [debtId], references: [id])

  @@id([payslipId, debtId])
  @@map("payslip_deductions")
}

// ─────────────────────────────────────────────────────────────
// COMMUNICATION
// ─────────────────────────────────────────────────────────────

/// One thread per parcel, from the Sortie coursier scan until the parcel is
/// delivered and paid or the return is received. It locks while the parcel sits
/// at the depot and reopens with the new livreur when it goes out again; that
/// livreur reads the whole history. The ramasseur never joins (A-23, Q15).
model ChatThread {
  id            String          @id @default(uuid()) @db.Uuid
  parcelId      String          @unique @db.Uuid
  sellerId      String          @db.Uuid
  /// The livreur who currently holds the parcel; null while it is at the depot.
  courierId     String?         @db.Uuid
  state         ChatThreadState @default(OUVERT)
  lastMessageAt DateTime?
  createdAt     DateTime        @default(now())

  parcel   Parcel        @relation(fields: [parcelId], references: [id])
  courier  Courier?      @relation(fields: [courierId], references: [id])
  messages ChatMessage[]
  reads    ChatRead[]

  @@index([sellerId, lastMessageAt])
  @@index([courierId, lastMessageAt])
  @@map("chat_threads")
}

model ChatMessage {
  id           String              @id @default(uuid()) @db.Uuid
  threadId     String              @db.Uuid
  senderUserId String              @db.Uuid
  /// Staff messages are shown as "Faffa Go" (Admin 4.8).
  senderKind   ChatParticipantKind
  body         String
  createdAt    DateTime            @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id])
  sender User       @relation(fields: [senderUserId], references: [id])

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

model ChatRead {
  threadId   String   @db.Uuid
  userId     String   @db.Uuid
  lastReadAt DateTime

  thread ChatThread @relation(fields: [threadId], references: [id])
  user   User       @relation(fields: [userId], references: [id])

  @@id([threadId, userId])
  @@map("chat_reads")
}

/// Appels Faffa Go: customer-service calls, visible to the seller. The seller's
/// own calls are never recorded (Vendeur rule 18).
model FaffaGoCall {
  id          String   @id @default(uuid()) @db.Uuid
  parcelId    String   @db.Uuid
  staffUserId String   @db.Uuid
  calledAt    DateTime @default(now())
  answered    Boolean
  note        String?

  parcel Parcel @relation(fields: [parcelId], references: [id])

  @@index([parcelId, calledAt])
  @@map("faffago_calls")
}

/// Parameters only, never rendered text: the courier app shows the same
/// notification in French or in Arabic (A-24).
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  params    Json
  parcelId  String?          @db.Uuid
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────
// ADDRESS MEMORY — couriers and staff only, never sellers (Coursier 4.3)
// ─────────────────────────────────────────────────────────────

/// A courier operation that is not a scan — Terminer le ramassage, a note
/// d'adresse — under the id the phone drew: sent again, it answers the same.
model CourierOperation {
  id          String   @id @db.Uuid
  actorUserId String   @db.Uuid
  kind        String
  deviceTime  DateTime
  receivedAt  DateTime @default(now())
  ok          Boolean
  code        String?
  message     String

  @@map("courier_operations")
}

model AddressMemory {
  id                String   @id @default(uuid()) @db.Uuid
  customerPhone     String   @unique @db.VarChar(8)
  note              String
  meetingPoint      String?
  delegationId      String?  @db.Uuid
  lastCourierUserId String   @db.Uuid
  deliveryCount     Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("address_memory")
}

// ─────────────────────────────────────────────────────────────
// SELLER CHANGE REQUESTS (Vendeur 4.6)
// ─────────────────────────────────────────────────────────────

model SellerChangeRequest {
  id              String              @id @default(uuid()) @db.Uuid
  parcelId        String              @db.Uuid
  sellerId        String              @db.Uuid
  requestedFields Json
  sellerNote      String?
  /// One EN_ATTENTE per parcel, enforced by a partial unique index (D-44).
  status          ChangeRequestStatus @default(EN_ATTENTE)
  /// Who closed it and when: staff applying or refusing, or the seller withdrawing.
  handledByUserId String?             @db.Uuid
  handledAt       DateTime?
  staffNote       String?
  /// Required to refuse, and the seller reads it (D-57).
  refusalReason   String?
  createdAt       DateTime            @default(now())
  /// Set when the seller edits it while it waits.
  editedAt        DateTime?

  parcel Parcel @relation(fields: [parcelId], references: [id])
  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([status, createdAt])
  @@index([parcelId])
  @@map("seller_change_requests")
}

// ─────────────────────────────────────────────────────────────
// AUDIT — APPEND-ONLY
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  actorRole   Role?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  reason      String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}

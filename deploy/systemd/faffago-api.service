# Faffa Go API (NestJS). Installed by deploy/setup-server.sh.
[Unit]
Description=Faffa Go API
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=faffago
Group=faffago
WorkingDirectory=/opt/faffago/apps/api
EnvironmentFile=/etc/faffago/faffago.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5
# Logs: journalctl -u faffago-api
StandardOutput=journal
StandardError=journal

# Hardening: the only place it writes is the documents directory (D-32).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/faffago/documents
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target

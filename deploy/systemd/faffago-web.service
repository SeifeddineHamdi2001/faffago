# Faffa Go web (Next.js: public site, seller space, back office).
# Listens on loopback only; Caddy is the way in.
[Unit]
Description=Faffa Go web
After=network-online.target faffago-api.service
Wants=network-online.target

[Service]
Type=simple
User=faffago
Group=faffago
WorkingDirectory=/opt/faffago/apps/web
EnvironmentFile=/etc/faffago/faffago.env
Environment=NODE_ENV=production
# pnpm hoists (node-linker=hoisted): next lives in the root node_modules.
ExecStart=/usr/bin/node /opt/faffago/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Next writes its image and fetch cache here.
ReadWritePaths=/opt/faffago/apps/web/.next
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target

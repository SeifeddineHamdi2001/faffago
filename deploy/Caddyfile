# Faffa Go reverse proxy. Installed by deploy/setup-server.sh as
# /etc/caddy/Caddyfile. Caddy obtains and renews the HTTPS certificates itself
# once the three DNS names point at this server.
#
#   www.mirely.store   the web app: public site, seller space, back office.
#                      Its address is printed in every label's QR code (D-43).
#   api.mirely.store   the API, for the courier app. The web app reaches the API
#                      on 127.0.0.1 and never goes through here.
#   mirely.store       redirects to www.
#
# Caddy sets X-Forwarded-For and X-Forwarded-Host; the API trusts them from
# loopback only (app.setup.ts).

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	log {
		output file /var/log/caddy/faffago.log {
			roll_size 20MiB
			roll_keep 10
		}
	}
}

www.mirely.store {
	import common

	# The courier app's APK and its checksum (tech-stack 5), put there by hand:
	#   /var/www/faffago-apk/faffago-coursier.apk
	#   /var/www/faffago-apk/faffago-coursier.apk.sha256
	handle_path /apk/* {
		root * /var/www/faffago-apk
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

api.mirely.store {
	import common
	# Seller documents go up to 10 MB (D-32); a CSV import is JSON up to 5 MB.
	request_body {
		max_size 12MB
	}
	reverse_proxy 127.0.0.1:3001
}

mirely.store {
	redir https://www.mirely.store{uri} permanent
}

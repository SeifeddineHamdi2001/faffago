# What `docker build` never sees (Dockerfile at the root).
.git
**/node_modules
**/.next
**/dist
**/.turbo
**/coverage
**/test-results
**/playwright-report
**/blob-report
*.tsbuildinfo
.pnpm-store

# Secrets and private files: never in an image.
**/.env
**/.env.*
!.env.example
**/storage
**/uploads

# The courier app's own build output and native folders (its package.json stays:
# the lockfile names it).
apps/courier/android
apps/courier/ios
apps/courier/.expo

# ─────────────────────────────────────────────────────────────
# Faffa Go — environment variables
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# Two roles (see apps/api/prisma/migrations/*_init):
#   faffago_owner — owns the schema, runs migrations.
#   faffago_app   — used by the running API. UPDATE/DELETE are revoked
#                   on parcel_events and audit_log for this role.
DATABASE_URL="postgresql://faffago_app:CHANGE_ME@localhost:5432/faffago?schema=public"
DATABASE_MIGRATION_URL="postgresql://faffago_owner:CHANGE_ME@localhost:5432/faffago?schema=public"
FAFFAGO_APP_DB_PASSWORD="CHANGE_ME"

# ── API ─────────────────────────────────────────────────────
API_PORT=3001
API_BASE_URL="http://localhost:3001"
NODE_ENV="development"

# ── Auth ────────────────────────────────────────────────────
# Sellers log in with email, staff with username, couriers with phone + role.
# Passwords are generated by the admin and hashed with argon2id.
# Both secrets: at least 32 random characters, e.g. `openssl rand -base64 48`.
# The API refuses to start without them.
#   JWT_ACCESS_SECRET  — signs access and "Voir comme le vendeur" tokens.
#   JWT_REFRESH_SECRET — HMAC key for the refresh tokens stored in the database.
# Session lifetimes are business rules (Q11) and live in packages/shared
# (SESSION_POLICY), not here.
JWT_ACCESS_SECRET="CHANGE_ME"
JWT_REFRESH_SECRET="CHANGE_ME"

# ── First admin account (seed only) ─────────────────────────
# The seed creates one admin if none exists. Leave the password empty and it
# generates one and prints it once; it is never readable again.
FAFFAGO_ADMIN_USERNAME="admin"
FAFFAGO_ADMIN_PASSWORD=""
FAFFAGO_ADMIN_PHONE="20000000"

# ── Private document storage (CIN / patente) ────────────────
# Admin-only, served through the API. Never a public URL.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# ── Web ─────────────────────────────────────────────────────
# The browser never calls the API: the Next.js server does, and keeps the
# tokens in httpOnly cookies (D-15). API_BASE_URL above is where it finds the
# API. Behind the reverse proxy, the proxy must set X-Forwarded-For and
# X-Forwarded-Host.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Public tracking rate limit ──────────────────────────────
PUBLIC_TRACKING_RATE_LIMIT_PER_MINUTE=20

# ── Monitoring (optional in development) ────────────────────
SENTRY_DSN=""

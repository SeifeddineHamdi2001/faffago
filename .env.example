# ─────────────────────────────────────────────────────────────
# Faffa Go — environment variables
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# Two roles (see apps/api/prisma/migrations/*_init):
#   faffago_owner — owns the schema, runs migrations.
#   faffago_app   — used by the running API. UPDATE/DELETE are revoked
#                   on parcel_events and audit_log for this role.
DATABASE_URL="postgresql://faffago_app:CHANGE_ME@localhost:5432/faffago?schema=public"
DATABASE_MIGRATION_URL="postgresql://faffago_owner:CHANGE_ME@localhost:5432/faffago?schema=public"
FAFFAGO_APP_DB_PASSWORD="CHANGE_ME"

# ── API ─────────────────────────────────────────────────────
API_PORT=3001
API_BASE_URL="http://localhost:3001"
NODE_ENV="development"

# ── Auth ────────────────────────────────────────────────────
# Sellers log in with email, staff with username, couriers with phone + role.
# Passwords are generated by the admin and hashed with argon2id.
# Both secrets: at least 32 random characters, e.g. `openssl rand -base64 48`.
# The API refuses to start without them.
#   JWT_ACCESS_SECRET  — signs access and "Voir comme le vendeur" tokens.
#   JWT_REFRESH_SECRET — HMAC key for the refresh tokens stored in the database.
# Session lifetimes are business rules (Q11) and live in packages/shared
# (SESSION_POLICY), not here.
JWT_ACCESS_SECRET="CHANGE_ME"
JWT_REFRESH_SECRET="CHANGE_ME"

# ── First admin account (seed only) ─────────────────────────
# The seed creates one admin if none exists. Leave the password empty and it
# generates one and prints it once; it is never readable again.
FAFFAGO_ADMIN_USERNAME="admin"
FAFFAGO_ADMIN_PASSWORD=""
FAFFAGO_ADMIN_PHONE="20000000"

# ── Private document storage (CIN / patente) ────────────────
# Admin-only, served through the API. Never a public URL (D-32).
# STORAGE_LOCAL_PATH: on the VPS, a directory outside the repository and
# outside anything the reverse proxy serves, e.g. /var/lib/faffago/documents,
# readable by the API's system user only. Relative paths start from apps/api.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# Every document is encrypted (AES-256-GCM) before it reaches the disk.
# The key: 32 random bytes in base64, `openssl rand -base64 32`. Keep a copy
# in two offline places: losing it loses every document. The API refuses to
# start without it.
#   STORAGE_ENCRYPTION_KEY_ID  written beside each new file (letters, digits, - _)
#   STORAGE_ENCRYPTION_PREVIOUS_KEYS  after a rotation only: "id:key,id:key"
# Check the files (and, with --decrypt, the key) after a restore:
#   pnpm --filter @faffago/api documents:verify --decrypt
STORAGE_ENCRYPTION_KEY_ID="k1"
STORAGE_ENCRYPTION_KEY="CHANGE_ME"
STORAGE_ENCRYPTION_PREVIOUS_KEYS=""

# ── Web ─────────────────────────────────────────────────────
# The browser never calls the API: the Next.js server does, and keeps the
# tokens in httpOnly cookies (D-15). API_BASE_URL above is where it finds the
# API. Behind the reverse proxy, the proxy must set X-Forwarded-For and
# X-Forwarded-Host.
# NEXT_PUBLIC_SITE_URL is also printed in the QR code of every label (D-36,
# D-43): set it once, never change it after labels are printed. The API reads
# it too. Production: https://www.mirely.store
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# How long the public site keeps Tarifs, Zones couvertes and the contact links
# before reading Paramètres again (Landing 6). Default 300; the browser tests
# use 0.
# PUBLIC_SITE_CACHE_SECONDS="300"

# ── Courier app (apps/courier/.env, read by Expo at build time) ──
# The API with its /api prefix, as the phone reaches it. Not a secret: it is
# compiled into the app. The default reaches `pnpm dev`'s API from the
# Android emulator.
# EXPO_PUBLIC_API_URL="http://10.0.2.2:3001/api"

# ── Monitoring (optional in development) ────────────────────
SENTRY_DSN=""
